APP_NAME=AI BOS Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Neon / Postgres (production): paste the Neon connection string.
# postgres:// and postgresql:// are auto-normalized to postgresql+psycopg2://
# sslmode=require is appended automatically when ENVIRONMENT=production.
DATABASE_URL=postgresql+psycopg2://aibos:aibos_dev@localhost:5433/aibos
# SQLite (local / tests):
# DATABASE_URL=sqlite:///./aibos.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Demo seed (orgs, ceo@demo.aibos.io, CRM, finance, HR, …).
# production default is false — set true once to fill an empty DB for testing.
SEED_DEMO_DATA=true

APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Secrets — required in production (JWT_SECRET or SECRET_KEY)
JWT_SECRET=change-me-in-production-please-use-32-plus-bytes
# SECRET_KEY=  # alias accepted if JWT_SECRET unset
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=60
REFRESH_TOKEN_EXP_DAYS=7
MAX_REFRESH_SESSIONS=5

# CORS — comma-separated origins. Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# OAuth Google (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth Microsoft Entra (optional)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Email — "log" locally, "smtp" in staging/production
EMAIL_MODE=log
PASSWORD_RESET_EXP_MINUTES=60
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=AI BOS <noreply@example.com>

# Stripe (optional — mock if absent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI / AI (optional — mock + RAG if absent)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# Token widget / copilot (must match VITE_CHATBOT_API_TOKEN)
# CHATBOT_API_TOKEN=
# QUERY_RATE_LIMIT=20/minute
# CHATBOT_QUERY_RATE_LIMIT=20

# Storage
# STORAGE_LOCAL_PATH=./storage
# BACKUP_DIR=./backups
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=aibos-documents
# S3_REGION=us-east-1

# PaaS
# PORT=8000
# HOST=0.0.0.0
# WEB_CONCURRENCY=1
