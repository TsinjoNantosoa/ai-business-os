APP_NAME=AI BOS Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://aibos:aibos_dev@localhost:5433/aibos
# SQLite (tests / offline) :
# DATABASE_URL=sqlite:///./aibos.db
# Docker Compose staging (port 5432) :
# DATABASE_URL=postgresql+psycopg2://aibos:aibos_staging@localhost:5432/aibos
DATABASE_ECHO=false
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
# OAuth Google (application Web Google Cloud)
# Redirect URI : http://localhost:8000/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth Microsoft Entra (App Registration, plateforme Web)
# Redirect URI : http://localhost:8000/api/v1/auth/oauth/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Emails transactionnels : "log" en local, "smtp" en staging/production.
EMAIL_MODE=log
PASSWORD_RESET_EXP_MINUTES=60
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=AI BOS <noreply@example.com>
# Stripe sandbox (optionnel — mock si absent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# OpenAI (optionnel — mock intelligent + RAG si absent)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Token widget / copilot (doit correspondre à VITE_CHATBOT_API_TOKEN frontend)
# CHATBOT_API_TOKEN=
# Limite requêtes chat par utilisateur (format: 20 ou 20/minute)
# QUERY_RATE_LIMIT=20/minute
# CHATBOT_QUERY_RATE_LIMIT=20
# ANTHROPIC_API_KEY=sk-ant-...
# Storage documents (local par défaut, MinIO/S3 optionnel)
# STORAGE_LOCAL_PATH=./storage
# BACKUP_DIR=./backups
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=aibos-documents
# S3_REGION=us-east-1
JWT_SECRET=change-me-in-production-please-use-32-plus-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=60
REFRESH_TOKEN_EXP_DAYS=7
MAX_REFRESH_SESSIONS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
