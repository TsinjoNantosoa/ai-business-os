APP_NAME=AI BOS Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./aibos.db
# PostgreSQL (production) :
# DATABASE_URL=postgresql+psycopg2://aibos:aibos@localhost:5432/aibos
DATABASE_ECHO=false
APP_PUBLIC_URL=http://localhost:5173
# Stripe sandbox (optionnel — mock si absent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# OpenAI (optionnel — mock intelligent + RAG si absent)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Token widget / copilot (doit correspondre à VITE_CHATBOT_API_TOKEN frontend)
# CHATBOT_API_TOKEN=
# Limite requêtes chat par utilisateur (format: 20 ou 20/minute)
# QUERY_RATE_LIMIT=20/minute
# CHATBOT_QUERY_RATE_LIMIT=20
# ANTHROPIC_API_KEY=sk-ant-...
# Storage documents (local par défaut, MinIO/S3 optionnel)
# STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=aibos-documents
# S3_REGION=us-east-1
JWT_SECRET=change-me-in-production-please-use-32-plus-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=60
REFRESH_TOKEN_EXP_DAYS=7
MAX_REFRESH_SESSIONS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
