# AI BOS Frontend — copy to .env (local) or set in Vercel Project Settings

# Backend API base URL (no trailing slash)
# Local:  http://localhost:8000
# Prod:   https://your-api.onrender.com
VITE_API_URL=http://localhost:8000

# Use in-memory mocks when true or when VITE_API_URL is empty
VITE_USE_MOCKS=false

# Auto-login as demo CEO on "/" — disable in production
VITE_AUTO_DEMO_LOGIN=true

# Must match backend CHATBOT_API_TOKEN when set
VITE_CHATBOT_API_TOKEN=

# Optional UI locale default
# VITE_DEFAULT_LOCALE=fr
